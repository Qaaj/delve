# Postgres connection string for a database you've created.
DATABASE_URL=postgresql://user:password@localhost:5432/delve

# Proton Mail Bridge connection. Open Proton Mail Bridge -> your account ->
# "Mailbox configuration" to see the exact host/port/username/password
# (NOT your real Proton password — Bridge generates its own local password).
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_SECURE=false
IMAP_USER=
IMAP_PASSWORD=

# Your Proton web account index, from the mail.proton.me/u/<N>/... URL you're
# logged in under.
PROTON_ACCOUNT_INDEX=0

# Where attachment blobs are stored on disk (content-addressed by md5+ext).
# Never persisted as an absolute path in the DB, so this is safe to change later.
ATTACHMENTS_DIR=/path/to/delve/attachments

# Optional tuning (defaults shown)
# IMPORT_CHUNK_SIZE=150
# IMPORT_MAX_BODY_CHARS=200000
# IMPORT_MAX_HTML_CHARS=300000
# IMPORT_MAX_ATTEMPTS=5
# IMPORT_EXCLUDE_MAILBOXES=Spam,Trash
